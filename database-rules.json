{
  "rules": {
    ".read": false,
    ".write": false,
    "sesiones": {
      ".read": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['tipo','codigo','ts']) && ( (newData.child('tipo').val() === 'brigada' && root.child('codigos_brigada').child(newData.child('codigo').val()).exists() && newData.child('color').val() === root.child('codigos_brigada').child(newData.child('codigo').val()).child('color').val()) || (newData.child('tipo').val() === 'mesa' && root.child('codigos_mesa').child(newData.child('codigo').val()).exists() && newData.child('mesa').val() === root.child('codigos_mesa').child(newData.child('codigo').val()).child('mesa').val()) )",
        "tipo":   { ".validate": "newData.isString()" },
        "codigo": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "color":  { ".validate": "newData.isString() && newData.val().length <= 20" },
        "mesa":   { ".validate": "newData.isString() && newData.val().length <= 10" },
        "ts":     { ".validate": "newData.isNumber()" },
        "$otros": { ".validate": false }
      }
    },
    "usuarios": {
      ".read": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
        ".validate": "newData.hasChildren(['nombre'])",
        "esAdmin": { ".validate": "newData.isBoolean()" }
      }
    },
    "padron": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).exists()",
      ".write": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      ".indexOn": ["mesa", "ci"],
      "$ci": {
        ".read": "auth != null && root.child('sesiones').child(auth.uid).exists()"
      }
    },
    "padron_info": {
      ".read": "auth != null",
      ".write": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true"
    },
    "estados": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).exists() || root.child('sesiones').child(auth.uid).exists())",
      ".indexOn": ["color"],
      "$ci": {
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).exists() || (root.child('sesiones').child(auth.uid).child('tipo').val() === 'mesa' && root.child('mesa_index').child(root.child('sesiones').child(auth.uid).child('mesa').val()).child($ci).exists()) || (root.child('sesiones').child(auth.uid).child('tipo').val() === 'brigada' && data.child('color').val() === root.child('sesiones').child(auth.uid).child('color').val()))",
        ".validate": "$ci.matches(/^[0-9]{1,10}$/)",
        "color":          { ".validate": "newData.isString() && newData.val().length <= 20" },
        "usuario":        { ".validate": "newData.isString() && newData.val().length <= 80" },
        "confirmado_por": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "votado_mesa_por":{ ".validate": "newData.isString() && newData.val().length <= 80" },
        "observacion":    { ".validate": "newData.isString() && newData.val().length <= 500" },
        "atendido":       { ".validate": "newData.isBoolean()" },
        "confirmado":     { ".validate": "newData.isBoolean()" },
        "votado_mesa":    { ".validate": "newData.isBoolean()" },
        "$otros":         { ".validate": true }
      }
    },
    "historial": {
      ".read": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      "$ci": {
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).exists() || root.child('sesiones').child(auth.uid).exists())",
        "$push": {
          ".validate": "newData.hasChildren(['accion','usuario','ts'])"
        }
      }
    },
    "codigos_brigada": {
      ".read": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      ".write": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      "$codigo": {
        ".read": "auth != null"
      }
    },
    "brigada_accesos": {
      ".read": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      "$codigo": {
        "$acc": { ".write": "auth != null" }
      }
    },
    "codigos_mesa": {
      ".read": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      ".write": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      "$codigo": {
        ".read": "auth != null"
      }
    },
    "mesa_index": {
      ".read": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      ".write": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      "$mesa": {
        ".read": "auth != null && (root.child('usuarios').child(auth.uid).exists() || root.child('sesiones').child(auth.uid).child('mesa').val() === $mesa)"
      }
    },
    "mesa_accesos": {
      ".read": "root.child('usuarios').child(auth.uid).child('esAdmin').val() === true",
      "$codigo": {
        "$acc": { ".write": "auth != null" }
      }
    }
  }
}
